# 이 파일은 참고용입니다. 직접 고칠 필요 없어요.
# `python setup.py` 를 실행하면 웹페이지에서 채워 줍니다.

# NH 나무 PLUG(https://www.nhplug.com)에서 앱을 만들면 받는 두 값.
# 모의투자와 실제 계좌가 같은 키를 씁니다.
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=

# 1 = 모의투자 계좌, 0 = 실제 계좌
NH_MOCK=1

# 실제 계좌로 주문할 때 승인을 받을 Telegram 봇.
# BotFather(https://t.me/BotFather)에서 만들고 setup.py 화면에서 연결합니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
